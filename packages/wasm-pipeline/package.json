{
  "name": "@xberg-io/wasm-pipeline",
  "version": "1.0.0-rc.27",
  "type": "module",
  "description": "Browser-side document-intelligence pipeline: xberg-wasm extract/OCR/chunk + on-device e5 embeddings (onnxruntime-web), GLiNER PII (gliner), EdgeVec RAG, and reversible redaction.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xberg-io/xberg-wasm": "1.0.0-rc.26",
    "@xberg-io/core": "workspace:*",
    "@xenova/transformers": "^2.17.2",
    "onnxruntime-web": "^1.24.2",
    "gliner": "^0.0.19",
    "edgevec": "^0.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fake-indexeddb": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^2.0.5"
  }
}
