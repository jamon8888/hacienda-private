{
  "name": "@xberg-io/mcp-server",
  "version": "1.0.0-rc.27",
  "type": "module",
  "private": true,
  "description": "Thin Node.js MCP server for the Xberg document-intelligence app: serves the browser UI, SHA256-pinned models, light metadata, an AES-GCM key vault, and mirrors the browser EdgeVec index. No engine logic.",
  "bin": {
    "xberg-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.js serve",
    "test": "vitest run"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.14.4",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xberg-io/core": "workspace:*",
    "@xberg-io/node-pipeline": "workspace:*",
    "@xberg-io/xberg-wasm": "workspace:*",
    "better-sqlite3": "^11.0.0",
    "edgevec": "^0.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }
}
